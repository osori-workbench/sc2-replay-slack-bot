REPLAY_DIR=/absolute/path/to/your/GoogleDrive-synced/Replays/Multiplayer
STATE_PATH=./state/processed_replays.json
GUIDES_DIR=./docs/guides
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ANALYZER_MODE=heuristic
# Optional: only process replays modified on/after this time
# MIN_REPLAY_MTIME='2026-05-18 00:00:00'

# Default Hermes ask API endpoint for final replay analysis
LLM_MODEL=hermes
LLM_API_BASE_URL=http://127.0.0.1:8787
# LLM_API_KEY=
